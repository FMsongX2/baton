  "fixed_sql": [
    {
      "name": "nodes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"nodes\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"parent_id\" INTEGER NULL REFERENCES nodes (id), \"kind\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"sort_index\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"deleted_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "scores",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"scores\" (\"node_id\" INTEGER NOT NULL REFERENCES nodes (id) ON DELETE CASCADE, \"file_rel\" TEXT NOT NULL, \"page_count\" INTEGER NOT NULL, \"bpm\" REAL NOT NULL DEFAULT 120.0, \"time_sig_num\" INTEGER NOT NULL DEFAULT 4, \"time_sig_den\" INTEGER NOT NULL DEFAULT 4, \"clicks_per_bar\" INTEGER NOT NULL DEFAULT 4, \"count_in_bars\" INTEGER NOT NULL DEFAULT 1, \"lead_beats\" REAL NOT NULL DEFAULT 2.0, \"page_order_json\" TEXT NULL, \"play_order_json\" TEXT NULL, \"composer\" TEXT NULL, \"memo\" TEXT NULL, PRIMARY KEY (\"node_id\"));"
        }
      ]
    },
    {
      "name": "score_pages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"score_pages\" (\"score_id\" INTEGER NOT NULL REFERENCES scores (node_id) ON DELETE CASCADE, \"page_index\" INTEGER NOT NULL, \"bar_count\" INTEGER NOT NULL DEFAULT 4, \"bpm\" REAL NULL, \"clicks_per_bar\" INTEGER NULL, PRIMARY KEY (\"score_id\", \"page_index\"));"
        }
      ]
    },
    {
      "name": "annotations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"annotations\" (\"score_id\" INTEGER NOT NULL REFERENCES scores (node_id) ON DELETE CASCADE, \"page_index\" INTEGER NOT NULL, \"strokes_json\" TEXT NOT NULL, PRIMARY KEY (\"score_id\", \"page_index\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
